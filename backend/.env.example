PORT=5050
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/transmaa

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# One-time bootstrap key used only to create the very first admin account
# (the bootstrap endpoint refuses to run once any staff/admin already exists)
STAFF_BOOTSTRAP_KEY=change_this_setup_key

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
